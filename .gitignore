# --- 機密情報・ローカル専用 ---
.env
.env.*
!.env.example
*.local.*
*.pem
*.key
/local/
/.local/*
!/.local/.gitkeep

# --- Python ---
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# --- ローカル DB・ログ ---
*.db
*.sqlite3
*.log

# --- OS・IDE ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- scripts/ の実採取データ（実行のたびに用意する作業ディレクトリ。生データは追跡しない） ---
/scripts/raw/
/scripts/captured/

# --- mod の型と tsconfig（本体が --plugin-dir の読み込みで書く生成物） ---
/plugin/tsconfig.json
/plugin/.claude-plugin/types/
